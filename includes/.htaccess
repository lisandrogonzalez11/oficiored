# =============================================================
# Bloquear todo acceso web directo a la carpeta includes/ (C2)
# Estos archivos solo deben usarse via require desde las paginas.
# =============================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
