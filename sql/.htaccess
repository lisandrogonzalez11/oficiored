# =============================================================
# Bloquear todo acceso web directo a la carpeta sql/ (C2)
# El dump de la base de datos no debe ser descargable por URL.
# =============================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
